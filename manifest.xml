<?xml version="1.0"?>
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        entry="MapsFavouritesApp"
        id="EB8BDC0B02DE4D02A79F2C2D9D873468"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="3.2.0"
        name="@Strings.AppName"
        type="watch-app">
        <iq:products>
            <!-- Alle Zielgeraete melden Connect IQ 6.0.0. Das Mindestlevel steht
                 trotzdem auf 3.2.0: erst ab da darf der Hintergrundprozess
                 Application.Storage schreiben, und genau darauf beruht der
                 Rueckkanal vom Dienst in den Vordergrund. -->
            <iq:product id="edge1050"/>
            <iq:product id="edge1040"/>
            <iq:product id="edge850"/>
            <iq:product id="edge840"/>
            <iq:product id="edge550"/>
            <iq:product id="edge540"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="Communications"/>
            <iq:uses-permission id="Background"/>
            <!-- Positioning wird schon fuers blosse Konstruieren einer
                 Position.Location verlangt, nicht erst fuer GPS-Zugriff. -->
            <iq:uses-permission id="Positioning"/>
            <iq:uses-permission id="PersistedContent"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>deu</iq:language>
            <iq:language>eng</iq:language>
        </iq:languages>
    </iq:application>
</iq:manifest>
